ngx_addon_name=ngx_http_oidc_module

if test -n "$ngx_module_link"; then
    ngx_module_type=HTTP
    ngx_module_name=ngx_http_oidc_module
    ngx_module_srcs="$ngx_addon_dir/src/ngx_http_oidc_module.c \
                    $ngx_addon_dir/src/ngx_http_oidc_http.c \
                    $ngx_addon_dir/src/ngx_http_oidc_jwt.c \
                    $ngx_addon_dir/src/ngx_http_oidc_json.c"
    ngx_module_libs="-ljansson -lsqlite3"

    . auto/module
else
    HTTP_MODULES="$HTTP_MODULES ngx_http_oidc_module"
    NGX_ADDON_SRCS="$NGX_ADDON_SRCS $ngx_addon_dir/src/ngx_http_oidc_module.c \
                    $ngx_addon_dir/src/ngx_http_oidc_http.c \
                    $ngx_addon_dir/src/ngx_http_oidc_jwt.c \
                    $ngx_addon_dir/src/ngx_http_oidc_json.c"

    CORE_LIBS="$CORE_LIBS -lssl -lcrypto -ljansson -lsqlite3"
fi
